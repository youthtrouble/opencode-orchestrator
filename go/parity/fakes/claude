#!/bin/sh
# Parity fake. It sits first on PATH so no parity case can reach the real CLI. A case that
# needs this CLI must script it; reaching this unscripted fake is a test failure.
#
# Scripted mode: when $HOME/fake-claude/case names a case, each argv element is appended as
# one line to $HOME/fake-log/claude-argv.txt, then $HOME/fake-claude/<case>.jsonl is printed
# on stdout and <case>.stderr on stderr (each if present), and the fake exits with the code in
# <case>.exit. Instead of exiting, <case>.signal makes it kill itself with that signal (so
# claude-exec sees a close code of null) and <case>.sleep makes it become /bin/sleep for that
# many seconds (so it is still running when the bridge signals it); with <case>.pid present it
# first writes its pid to $HOME/fake-claude/pid (outside the compared logs), so a case can
# check that the process was signalled. Shell builtins only: PATH holds no coreutils.
# Canned answers (the doctor group), checked before every other mode: when
# $HOME/fake-answers/claude/<argv joined by "-"> exists (e.g. --version, login-status,
# debug-agents), it is printed on stdout with every line newline-terminated and the fake exits
# with the code in <same>.exit, or 0.
answer="$HOME/fake-answers/claude/$(IFS=-; printf '%s' "$*")"
if [ -f "$answer" ]; then
  while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done < "$answer"
  code=0
  if [ -f "$answer.exit" ]; then IFS= read -r code < "$answer.exit"; fi
  exit "$code"
fi
script="$HOME/fake-claude"
if [ -f "$script/case" ]; then
  IFS= read -r case < "$script/case"
  for arg in "$@"; do printf '%s\n' "$arg" >> "$HOME/fake-log/claude-argv.txt"; done
  if [ -f "$script/$case.jsonl" ]; then
    while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done < "$script/$case.jsonl"
  fi
  if [ -f "$script/$case.stderr" ]; then
    while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line" >&2; done < "$script/$case.stderr"
  fi
  if [ -f "$script/$case.signal" ]; then
    IFS= read -r sig < "$script/$case.signal"
    kill "-$sig" $$
  fi
  if [ -f "$script/$case.sleep" ]; then
    IFS= read -r seconds < "$script/$case.sleep"
    if [ -f "$script/$case.pid" ]; then printf '%s\n' $$ > "$script/pid"; fi
    exec /bin/sleep "$seconds"
  fi
  code=0
  if [ -f "$script/$case.exit" ]; then IFS= read -r code < "$script/$case.exit"; fi
  exit "$code"
fi
echo "parity fake $(basename "$0"): not scripted for this case (argv: $*)" >&2
exit 97
