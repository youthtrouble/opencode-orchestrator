#!/bin/sh
# Parity fake. It sits first on PATH so no parity case can reach the real CLI. A case that
# needs this CLI must script it; reaching this unscripted fake is a test failure.
#
# Scripted `codex app-server`: when $HOME/fake-codex/ exists, every stdin line is appended to
# $HOME/fake-log/codex-app-server.jsonl and the n-th line is answered with the contents of
# $HOME/fake-codex/<n>, if present.
#
# Scripted `codex exec`: when $HOME/fake-codex-exec/case names a case, each argv element is
# appended as one line to $HOME/fake-log/codex-argv.txt, the physical working directory is
# written to codex-cwd.txt and CLAUDECODE (or <unset>) to codex-env.txt. Unless
# <case>.nostdin exists, stdin is then read to its end into codex-stdin.txt, with a
# "<no newline at end>" line after an unterminated last line. Then <case>.jsonl, .stderr,
# .signal, .sleep and .exit act as in the claude fake.
#
# Scripted `codex queue` (the supervisor's codex-queue wake channel): when
# $HOME/fake-codex-queue/exit exists, each argv element is appended as one line to
# $HOME/fake-log/codex-queue-argv.txt and the fake exits with the code the file holds.
#
# Shell builtins only (and /bin/sleep by its path): a fake must not depend on
# what else PATH holds.
# Canned answers (the doctor group), checked before every other mode: when
# $HOME/fake-answers/codex/<argv joined by "-"> exists (e.g. --version, login-status,
# debug-agents), it is printed on stdout with every line newline-terminated and the fake exits
# with the code in <same>.exit, or 0.
answer="$HOME/fake-answers/codex/$(IFS=-; printf '%s' "$*")"
if [ -f "$answer" ]; then
  while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done < "$answer"
  code=0
  if [ -f "$answer.exit" ]; then IFS= read -r code < "$answer.exit"; fi
  exit "$code"
fi
script="$HOME/fake-codex"
if [ "$1" = app-server ] && [ -d "$script" ]; then
  n=0
  while IFS= read -r line; do
    printf '%s\n' "$line" >> "$HOME/fake-log/codex-app-server.jsonl"
    n=$((n + 1))
    if [ -f "$script/$n" ]; then
      while IFS= read -r reply; do printf '%s\n' "$reply"; done < "$script/$n"
    fi
  done
  exit 0
fi
script="$HOME/fake-codex-queue"
if [ "$1" = queue ] && [ -f "$script/exit" ]; then
  for arg in "$@"; do printf '%s\n' "$arg" >> "$HOME/fake-log/codex-queue-argv.txt"; done
  IFS= read -r code < "$script/exit"
  exit "$code"
fi
script="$HOME/fake-codex-exec"
if [ "$1" = exec ] && [ -f "$script/case" ]; then
  IFS= read -r case < "$script/case"
  log="$HOME/fake-log"
  for arg in "$@"; do printf '%s\n' "$arg" >> "$log/codex-argv.txt"; done
  pwd -P > "$log/codex-cwd.txt"
  printf 'CLAUDECODE=%s\n' "${CLAUDECODE-<unset>}" > "$log/codex-env.txt"
  if [ ! -f "$script/$case.nostdin" ]; then
    : > "$log/codex-stdin.txt"
    while IFS= read -r line; do printf '%s\n' "$line" >> "$log/codex-stdin.txt"; done
    if [ -n "$line" ]; then printf '%s\n<no newline at end>\n' "$line" >> "$log/codex-stdin.txt"; fi
  fi
  if [ -f "$script/$case.jsonl" ]; then
    while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done < "$script/$case.jsonl"
  fi
  if [ -f "$script/$case.stderr" ]; then
    while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line" >&2; done < "$script/$case.stderr"
  fi
  if [ -f "$script/$case.signal" ]; then
    IFS= read -r sig < "$script/$case.signal"
    kill "-$sig" $$
  fi
  if [ -f "$script/$case.sleep" ]; then
    IFS= read -r seconds < "$script/$case.sleep"
    exec /bin/sleep "$seconds"
  fi
  code=0
  if [ -f "$script/$case.exit" ]; then IFS= read -r code < "$script/$case.exit"; fi
  exit "$code"
fi
# An unscripted app-server still reads the first request before it fails, as a real one would:
# exiting first races the parent's write into a closed pipe (EPIPE), which macOS rarely and
# Linux often loses.
if [ "$1" = app-server ]; then IFS= read -r request || :; fi
echo "parity fake ${0##*/}: not scripted for this case (argv: $*)" >&2
exit 97
